@model User
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "View User";
}

<h2>View User Details</h2>
<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">@Model.FullName</h5>
        <p class="card-text"><strong>Email:</strong> @Model.Email</p>
        <p class="card-text"><strong>Phone:</strong> @Model.Phone</p>
        <p class="card-text"><strong>Role:</strong> @Model.Role</p>
        <a href="/Admin/UserList" class="btn btn-secondary">Back to User List</a>
    </div>
</div>
