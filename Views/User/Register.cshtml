@model CateringManagement.Models.RegisterRequest
@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h3 class="card-title text-center mb-4 text-danger">Register</h3>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <form method="post" action="/User/Register">
                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input type="text" name="FullName" class="form-control" placeholder="Enter your full name" required value="@Model?.FullName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="Email" class="form-control" placeholder="Enter your email" required value="@Model?.Email" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input type="text" name="Phone" class="form-control" placeholder="Enter your phone number" required value="@Model?.Phone" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input type="password" name="Password" class="form-control" placeholder="Enter your password" required />
                    </div>
                    <button type="submit" class="btn btn-danger w-100">Register</button>
                </form>

                <p class="text-center mt-3">
                    Already have an account? <a href="/Auth/Login" class="text-danger fw-bold">Login here</a>
                </p>
            </div>
        </div>
    </div>
</div>